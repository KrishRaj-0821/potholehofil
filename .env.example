# ==========================================
# PotholeHofile (Kasba - 854330) Environment Config
# ==========================================

# 1. Google Gemini 1.5 Flash Vision & AI LLM API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Firebase Config (Cloud Firestore & Firebase Storage)
# Get from: Firebase Console -> Project Settings -> General -> Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# 3. Supabase PostgreSQL & PostGIS Spatial Database (Optional / Secondary)
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 4. Upstash Redis (Zero-Login Rate Limiting & Anti-Fraud) - Optional
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# 5. App Geofencing Configuration (Default: Kasba 854330)
NEXT_PUBLIC_TARGET_PIN=854330
NEXT_PUBLIC_CENTER_LAT=25.8452
NEXT_PUBLIC_CENTER_LNG=87.5341
NEXT_PUBLIC_GEO_RADIUS_KM=25.0

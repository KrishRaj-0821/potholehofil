rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pothole Posts Collection (Zero-Login Public Platform)
    match /pothole_posts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['imageUrl', 'memeCaption', 'severity', 'location'])
                   && request.resource.data.location.pin == '854330';
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes', 'commentCount', 'comments']);
      allow delete: if false;
    }

    // IP Votes Collection (Anti-Fraud Zero-Login Tracking)
    match /ip_votes/{voteId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Comments Collection
    match /post_comments/{commentId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
